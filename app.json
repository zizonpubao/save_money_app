{
  "expo": {
    "name": "SaveLog",
    "slug": "savelog",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "savelog",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.zizonpubao.savelog",
      "buildNumber": "6",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDevelopmentRegion": "ko",
        "CFBundleLocalizations": [
          "ko"
        ],
        "NSMicrophoneUsageDescription": "SaveLog는 마이크로 녹음하지 않습니다. 효과음을 재생하는 오디오 모듈에 녹음 기능이 함께 들어 있어 표시되는 항목입니다."
      }
    },
    "android": {
      "package": "com.zizonpubao.savelog",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#23794B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FAF6EF",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#131517"
          }
        }
      ],
      "expo-sqlite",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0497fa65-9040-44b7-8ffb-b1b378436780"
      }
    },
    "owner": "zizonpubao"
  }
}
